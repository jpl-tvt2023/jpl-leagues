# Optional local overlay for the test suite. Copy to `.env.test.local` and fill
# in to run the Redis-dependent specs (tests/league-types/redis-paths.spec.ts);
# without it those specs skip and everything else runs exactly as before.
#
# `.env.test.local` is gitignored by the `.env*` rule. Do NOT put these values
# in `.env.test` — that file is force-committed (.gitignore) and real tokens
# there would be pushed to GitHub.
#
# Use a DEDICATED Upstash database (e.g. `jpl-leagues-test`), never production's.
# `npm run test:reset` FLUSHES this database.
#
# Take both values from the Upstash console's "REST API" panel — @upstash/redis
# speaks HTTP, so the redis:// protocol URL will not work.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required by `npm run test:reset` before it will flush the database above.
# Deliberately not defaulted: it is the guard against a mis-pasted prod URL.
TEST_REDIS_CONFIRM=

# The rate limiter keys off Redis, so configuring one above would switch it on
# and 429 the suite (32 team sign-ins in a beforeAll vs a 5/min cap).
# `.env.test` sets RATE_LIMIT_ENABLED=0; leave it that way.
