{
  "name": "jpl-tvt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:push:dev": "dotenv -e .env.dev -- drizzle-kit push",
    "db:studio:dev": "dotenv -e .env.dev -- drizzle-kit studio",
    "db:push:test": "dotenv -e .env.test -- drizzle-kit push",
    "seed:dev": "dotenv -e .env.dev -- tsx scripts/dev-seed.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:reset": "dotenv -e .env.test.local -e .env.test -- tsx scripts/test-reset.ts",
    "test:e2e": "dotenv -e .env.test.local -e .env.test -- playwright test",
    "test:e2e:ui": "dotenv -e .env.test.local -e .env.test -- playwright test --ui",
    "test-cases:build": "tsx scripts/build-test-cases-xlsx.ts",
    "smoke:staging": "tsx scripts/smoke-staging.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.17.2",
    "@upstash/redis": "^1.37.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.1",
    "jszip": "^3.10.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
