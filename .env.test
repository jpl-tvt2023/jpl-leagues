# Test environment — used by `npm run test:reset` and `npm run test:e2e`.
# This file is intentionally checked in: it contains no real secrets, only a
# local SQLite path and a throwaway HMAC secret used to sign sessions in tests.
#
# DO NOT add Turso credentials, Upstash tokens, or any prod URL here.
# The reset script (scripts/test-reset.ts) refuses to run unless DATABASE_URL
# starts with file:./test, so even a copy-paste mistake won't touch Turso.

DATABASE_URL=file:./test.db
SESSION_SECRET=test-only-session-secret-do-not-use-in-prod-32chars

# Upstash is deliberately blank here so the default `npm run test:e2e` needs no
# accounts and no setup. To exercise the Redis-backed paths, copy
# .env.test.local.example to .env.test.local and fill it in -- that file is
# loaded FIRST and so overrides these blanks. Never put real tokens in THIS
# file: it is force-committed (see .gitignore).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Keep the rate limiter off even when the overlay above supplies a Redis.
# The suite drives every request from one IP and signs in up to 32 teams in a
# single beforeAll, against a 5/min cap on /api/auth/signin.
RATE_LIMIT_ENABLED=0

# Cron secret intentionally absent so /api/cron/* returns 500 in tests
# (no spec should hit cron routes directly).

NODE_ENV=test

# Point every FPL call at the in-app deterministic stub
# (src/app/api/test-fpl-stub). Without this the suite would hit the real,
# undocumented FPL API — the gateway throws rather than allow that, so if you
# see "refusing to call the live FPL API", this line is missing or the port is
# wrong. TEST_PORT defaults to 3100 (see playwright.config.ts).
# `next dev` forces NODE_ENV=development regardless of what this file says,
# so the stub route and the gateway's live-FPL guard key off this flag instead.
TEST_FPL_STUB=1
FPL_BASE_URL=http://localhost:3100/api/test-fpl-stub
