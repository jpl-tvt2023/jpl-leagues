# Test environment — used by `npm run test:reset` and `npm run test:e2e`.
# This file is intentionally checked in: it contains no real secrets, only a
# local SQLite path and a throwaway HMAC secret used to sign sessions in tests.
#
# DO NOT add Turso credentials, Upstash tokens, or any prod URL here.
# The reset script (scripts/test-reset.ts) refuses to run unless DATABASE_URL
# starts with file:./test, so even a copy-paste mistake won't touch Turso.

DATABASE_URL=file:./test.db
SESSION_SECRET=test-only-session-secret-do-not-use-in-prod-32chars

# Disable rate limiter (no Upstash configured in tests — middleware fails open).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron secret intentionally absent so /api/cron/* returns 500 in tests
# (no spec should hit cron routes directly).

NODE_ENV=test
